{
  "name": "jbrowse-plugin-intermine",
  "version": "0.1.0",
  "description": "JBrowse 2 plugin that reads genome data live from an InterMine web service",
  "license": "MIT",
  "keywords": [
    "jbrowse",
    "jbrowse2",
    "intermine"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intermineorg/jbrowse2.git",
    "directory": "plugin"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsc && NODE_ENV=production rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.config.live.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "version": "node scripts/version.mjs"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@jbrowse/core": "^4.3.0",
    "@jbrowse/mobx-state-tree": "^5.6.0",
    "@mui/material": "^7.3.10",
    "@mui/system": "^7.3.10",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "mobx": "^6.15.0",
    "mobx-react": "^9.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rimraf": "^6.1.3",
    "rollup": "^4.34.9",
    "rollup-plugin-external-globals": "^0.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
